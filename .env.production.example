# Copy to .env.production on the VM. Never commit the real file.
# Generate independent random values: openssl rand -hex 32
POSTGRES_DB=basketvision
POSTGRES_USER=basketvision
POSTGRES_PASSWORD=
AUTH_SIGNING_KEY=

# Identity requires at least 12 characters, uppercase/lowercase, digit and symbol.
# Example generation command (not a password): printf 'Aa1!'; openssl rand -hex 24
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=
SEED_DEMO_EMAIL=
SEED_DEMO_PASSWORD=

# Leave these defaults unless they overlap an existing Docker/VPN network.
# If changed, CADDY_IPV4 must be inside PROD_SUBNET, outside PROD_DYNAMIC_RANGE,
# and different from the gateway (.1).
PROD_SUBNET=172.30.80.0/24
PROD_DYNAMIC_RANGE=172.30.80.128/25
CADDY_IPV4=172.30.80.2

# Build one service at a time on the small VM.
COMPOSE_PARALLEL_LIMIT=1
