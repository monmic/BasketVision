# Copy to .env; choose strong unique values. Never commit .env.
AUTH_SIGNING_KEY=
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=
SEED_DEMO_EMAIL=
SEED_DEMO_PASSWORD=
# Local HTTP only. Set true when serving through HTTPS.
AUTH_SECURE_COOKIES=false

# Experimental tracker; keep off until validated on broader annotations.
BALL_TRACK_TEMPORAL_WINDOW=false
# Adds shot-motion eligibility; preserves detections of real stationary balls.
BALL_CAMERA_MOTION_FILTER=false
BALL_TRACK_CONFIRM_WINDOW_SECONDS=0.2
BALL_TRACK_RECOVERY_SECONDS=0.1
