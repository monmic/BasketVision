FROM mcr.microsoft.com/dotnet/sdk:8.0
WORKDIR /src
COPY . .
RUN dotnet restore tests/BasketVision.Tests/BasketVision.Tests.csproj
RUN dotnet build tests/BasketVision.Tests/BasketVision.Tests.csproj -c Release --no-restore
CMD ["dotnet", "test", "tests/BasketVision.Tests/BasketVision.Tests.csproj", "-c", "Release", "--no-build", "--logger", "console;verbosity=normal"]
