FROM python:3.12-slim
WORKDIR /app

RUN apt-get update \
    && apt-get install -y --no-install-recommends ffmpeg libgl1 libglib2.0-0 \
    && rm -rf /var/lib/apt/lists/*

# Match the development runtime versions, but omit NVIDIA/CUDA dependencies.
RUN pip install --no-cache-dir torch==2.14.0 torchvision==0.29.0 \
    --index-url https://download.pytorch.org/whl/cpu
COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt ultralytics==8.4.154 lap==0.5.13
COPY worker.py .
COPY person_tracker_diagnostic.yaml .
CMD ["python", "worker.py"]
